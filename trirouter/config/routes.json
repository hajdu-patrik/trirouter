{
  "_comment": "Per provider: task + difficulty (0/1/2) -> tier; targets.json turns the tier into agent / model / effort / text. Claude answers trivial work inline (a subagent for it costs more than it saves); '+verify:<tool>' adds a cross-check through cli-bridge (Claude only); cloud_replace applies in a cloud sandbox (ROUTER_MODE=cloud or CLAUDE_CODE_REMOTE=true), where no Codex / Antigravity login and no user-level agents exist.",
  "claude": {
    "default": "main",
    "long_context_target": "cli:antigravity",
    "table": {
      "qa":       ["main", "main", "deep"],
      "general":  ["main", "main", "deep"],
      "math":     ["main", "deep", "deep+verify:antigravity"],
      "study":    ["main", "main", "deep"],
      "code":     ["main", "main", "deep+verify:codex"],
      "test":     ["test", "test", "deep"],
      "research": ["main", "main", "main"]
    },
    "cloud_replace": {"cli:antigravity": "main", "cli:codex": "main", "fast": "main", "fable": "main", "sonnet": "main", "test": "main", "deep": "main"},
    "cost_cap": {
      "_comment": "Caps the model family of a Claude subagent: max_family (difficulty -> highest family), by_task overrides it per task; a tier or JEV-picked model above the cap is lowered (an explicit #opus / #fable is never capped). short_chat_*: a plain prompt shorter than short_chat_chars (no code, path or file name) in short_chat_tasks never runs above short_chat_max_family; inline stays inline.",
      "families": ["haiku", "sonnet", "opus", "fable"],
      "tier_family": {"fast": "haiku", "sonnet": "sonnet", "test": "sonnet", "deep": "opus", "fable": "fable"},
      "family_tier": {"haiku": "fast", "sonnet": "sonnet", "opus": "deep", "fable": "fable"},
      "max_family": {"0": "sonnet", "1": "opus", "2": "fable"},
      "by_task": {
        "qa": {"1": "sonnet"},
        "general": {"1": "sonnet"},
        "research": {"1": "sonnet"},
        "study": {"1": "sonnet"}
      },
      "short_chat_chars": 40,
      "short_chat_max_family": "haiku",
      "short_chat_tasks": ["general", "qa"]
    }
  },
  "codex": {
    "default": "main",
    "long_context_target": "deep",
    "table": {
      "qa":       ["fast", "main", "deep"],
      "general":  ["fast", "main", "deep"],
      "math":     ["main", "deep", "deep"],
      "study":    ["main", "main", "deep"],
      "code":     ["main", "main", "deep"],
      "test":     ["main", "main", "deep"],
      "research": ["main", "main", "main"]
    }
  },
  "antigravity": {
    "default": "main",
    "long_context_target": "deep",
    "table": {
      "qa":       ["fast", "main", "deep"],
      "general":  ["fast", "main", "deep"],
      "math":     ["main", "deep", "deep"],
      "study":    ["main", "main", "deep"],
      "code":     ["main", "main", "deep"],
      "test":     ["main", "main", "deep"],
      "research": ["main", "main", "main"]
    }
  }
}
