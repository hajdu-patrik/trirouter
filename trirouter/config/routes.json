{
  "_comment": "Per provider: task + difficulty (0/1/2) -> tier (optionally '+verify:<tool>'); targets.json turns the tier into agent / model / effort / text.",
  "claude": {
    "default": "main",
    "long_context_target": "cli:antigravity",
    "table": {
      "qa":       ["main", "main", "deep"],
      "general":  ["main", "main", "deep"],
      "math":     ["main", "deep", "deep+verify:antigravity"],
      "study":    ["main", "main", "deep"],
      "code":     ["main", "main", "deep+verify:codex"],
      "test":     ["test", "test", "deep"],
      "research": ["main", "main", "main"]
    },
    "cloud_replace": {"cli:antigravity": "main", "cli:codex": "main", "fast": "main", "fable": "main", "sonnet": "main", "test": "main", "deep": "main"},
    "cost_cap": {
      "_comment": "Claude subagent cost cap: max_family per difficulty, by_task overrides it per task; short plain prompts stay on short_chat_max_family.",
      "families": ["haiku", "sonnet", "opus", "fable"],
      "tier_family": {"fast": "haiku", "sonnet": "sonnet", "test": "sonnet", "deep": "opus", "fable": "fable"},
      "family_tier": {"haiku": "fast", "sonnet": "sonnet", "opus": "deep", "fable": "fable"},
      "max_family": {"0": "sonnet", "1": "opus", "2": "fable"},
      "by_task": {
        "qa": {"1": "sonnet"},
        "general": {"1": "sonnet"},
        "research": {"1": "sonnet"},
        "study": {"1": "sonnet"}
      },
      "short_chat_chars": 40,
      "short_chat_max_family": "haiku",
      "short_chat_tasks": ["general", "qa"]
    }
  },
  "codex": {
    "default": "main",
    "long_context_target": "deep",
    "table": {
      "qa":       ["fast", "main", "deep"],
      "general":  ["fast", "main", "deep"],
      "math":     ["main", "deep", "deep"],
      "study":    ["main", "main", "deep"],
      "code":     ["main", "main", "deep"],
      "test":     ["main", "main", "deep"],
      "research": ["main", "main", "main"]
    }
  },
  "antigravity": {
    "default": "main",
    "long_context_target": "deep",
    "table": {
      "qa":       ["fast", "main", "deep"],
      "general":  ["fast", "main", "deep"],
      "math":     ["main", "deep", "deep"],
      "study":    ["main", "main", "deep"],
      "code":     ["main", "main", "deep"],
      "test":     ["main", "main", "deep"],
      "research": ["main", "main", "main"]
    }
  }
}
